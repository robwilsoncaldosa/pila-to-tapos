TEAM_PASSCODE=
TEAM_COOKIE_SECRET=
# Set to http://<laptop-ip>:3000 so the TV's QR code works from a phone. Empty falls back to the address the TV was opened on.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# How the TV speaks a call: auto (default; the browser's Filipino voice if it has one, else the default voice told it is fil-PH),
# voice (same as auto), or clips (play public/audio/numero.mp3, letter-b.mp3, digit-0..9.mp3, counter.mp3; falls back to the voice if a clip is missing).
NEXT_PUBLIC_SPEECH_MODE=auto
# PILA_DEMO_RESET=1  # enables POST /api/demo-reset (video recording only)
